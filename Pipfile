[dev-packages]
# Notebook and packaging tooling. This belongs to the repository, not to the
# frozen model: it is what runs the notebooks and what builds the wheel and the
# API documentation, and it is deliberately not mirrored into
# network-design-bss/requirements.txt.
pytest = "*"        # demo/experiments/tests
ipykernel = "*"
jupyter = "*"
nbconvert = "*"
nbformat = "*"
build = "*"          # python build_package.py
setuptools = ">=68"  # build backend, pinned by build_package.py's pyproject
wheel = "*"
pdoc = "*"           # python build_docs.py

# No [requires] python_version pin on purpose.
#
# A pin is the first thing pipenv checks, and a missing interpreter aborts the
# install outright ("Python 3.12 was not found on your system") even when every
# dependency would have resolved cleanly. That is what the previous pin did on
# a machine running 3.13.
#
# Python >= 3.9 is required: network-design-bss/ annotates with PEP 585 builtin
# generics. Verified here on 3.13 and 3.14; without a pin pipenv takes whatever
# `python3` resolves to. To reproduce a published run on its exact interpreter:
#
#     pipenv --python 3.13 install --dev
