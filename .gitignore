# Data
# Scoped to the repository root so that it does NOT swallow nested input data
# such as network-design-bss/src/data/geojson/ (a bare `data` matches at any depth).
/data
/plot
!demo/frontend/data
!demo/experiments/data
!demo/experiments/results

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
*.egg
*.egg-info/
dist/
build/
*.whl
# ...except the published artefacts: the wheel build_package.py writes, and the
# superseded 0.1.0 build kept under legacy/ for reference.
!network-design-bss/sdk/**/*.whl

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
nosetests.xml
coverage.xml
*.coveragerc

# Sphinx documentation
docs/_build/

# pyenv
.python-version

# Environments
.env
.env.*
*.env

# IDEs and editors
.vscode/
.idea/

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log
*.out
*.err
# Front-end demo (demo/frontend) — Astro + React
demo/frontend/node_modules/
demo/frontend/dist/
demo/frontend/.astro/
# GENERATED by scripts/prepare-data.mjs from demo/experiments — never hand-edited, never committed
demo/frontend/public/data/
.specs